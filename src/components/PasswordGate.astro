---
import { SITE_AUTH_CONFIG } from '../config/sitePassword';

interface Props {
  accent?: string;
}

const { accent = '#E0A030' } = Astro.props;
---

<div id="sd-password-gate" class="sd-gate-wrapper" aria-modal="true" role="dialog" aria-label="Password entry">
  <!-- Landing page hero background & atmosphere -->
  <div class="sd-gate-bg" aria-hidden="true"></div>
  <div class="sd-gate-overlay" aria-hidden="true"></div>
  <div class="sd-gate-orb" aria-hidden="true" style={`background: ${accent};`}></div>

  <!-- Centered simple entry box -->
  <div class="sd-gate-container">
    <div class="sd-gate-brand">
      <span class="sd-brand-name">{SITE_AUTH_CONFIG.studioName}</span>
      <span class="sd-brand-dot" style={`background: ${accent};`}></span>
    </div>

    <form id="sd-gate-form" class="sd-gate-form" novalidate>
      <div class="sd-single-box" id="sd-input-wrapper">
        <input
          id="sd-passkey-input"
          type="password"
          name="passkey"
          class="sd-pass-input"
          placeholder="Enter password..."
          autocomplete="current-password"
          required
          spellcheck="false"
        />

        <button
          type="button"
          id="sd-toggle-visibility"
          class="sd-toggle-btn"
          aria-label="Toggle password visibility"
          title="Show / hide password"
        >
          <!-- Eye icon -->
          <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <!-- Eye off icon -->
          <svg id="eye-off-icon" class="is-hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          </svg>
        </button>

        <button
          type="submit"
          id="sd-gate-submit"
          class="sd-submit-arrow"
          aria-label="Submit password"
          title="Enter studio"
          style={`background: ${accent};`}
        >
          <svg class="sd-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <div id="sd-gate-error" class="sd-gate-error" role="alert" aria-live="polite"></div>
    </form>
  </div>
</div>

<style>
  .sd-gate-wrapper {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #2A3036;
    overflow: hidden;
    padding: 24px;
    box-sizing: border-box;
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  .sd-gate-wrapper.is-unlocking {
    opacity: 0;
    transform: scale(1.02);
    filter: blur(10px);
    pointer-events: none;
  }

  .sd-gate-wrapper.is-hidden {
    display: none !important;
  }

  /* Matching the exact background image from Hero section */
  .sd-gate-bg {
    position: absolute;
    inset: 0;
    background-image: url(/assets/806408f67066834bd64370cdf37369f2.jpg);
    background-size: cover;
    background-position: center 55%;
    z-index: 0;
  }

  .sd-gate-overlay {
    position: absolute;
    inset: 0;
    background: rgba(22, 27, 32, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 1;
  }

  .sd-gate-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 440px;
    height: 440px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.16;
    mix-blend-mode: color;
    z-index: 1;
    pointer-events: none;
  }

  /* Centered container */
  .sd-gate-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .sd-gate-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    user-select: none;
  }

  .sd-brand-name {
    font-family: 'Archivo', sans-serif;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #F2F3F0;
  }

  .sd-brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    box-shadow: 0 0 10px currentColor;
  }

  .sd-gate-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The single small box */
  .sd-single-box {
    position: relative;
    width: 100%;
    height: 52px;
    background: rgba(26, 32, 38, 0.65);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(242, 243, 240, 0.22);
    border-radius: 999px;
    padding: 4px 6px 4px 20px;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.4);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .sd-single-box:focus-within {
    border-color: #E0A030;
    box-shadow: 0 0 0 3px rgba(224, 160, 48, 0.2), 0 12px 36px rgba(0, 0, 0, 0.45);
    background: rgba(26, 32, 38, 0.85);
  }

  .sd-single-box.is-invalid {
    border-color: #FF5A5A;
    box-shadow: 0 0 0 3px rgba(255, 90, 90, 0.22);
    animation: sd-shake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes sd-shake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
    40%, 60% { transform: translate3d(4px, 0, 0); }
  }

  .sd-pass-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Geist Mono', monospace;
    font-size: 14px;
    color: #F2F3F0;
    letter-spacing: 0.02em;
    padding: 0 8px 0 0;
  }

  .sd-pass-input::placeholder {
    color: #8C96A0;
    font-family: 'Archivo', sans-serif;
    font-size: 14px;
    letter-spacing: 0;
  }

  .sd-toggle-btn {
    background: transparent;
    border: none;
    outline: none;
    padding: 6px;
    margin-right: 4px;
    color: #7A848F;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color 0.2s ease;
  }

  .sd-toggle-btn:hover {
    color: #F2F3F0;
  }

  .is-hidden {
    display: none !important;
  }

  .sd-submit-arrow {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    border: none;
    outline: none;
    color: #1F262D;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease;
    box-shadow: 0 2px 10px rgba(224, 160, 48, 0.35);
  }

  .sd-submit-arrow:hover {
    transform: scale(1.06);
    filter: brightness(1.1);
  }

  .sd-submit-arrow:active {
    transform: scale(0.96);
  }

  .sd-submit-arrow.is-success {
    background: #38A169 !important;
    color: #FFFFFF !important;
    box-shadow: 0 2px 12px rgba(56, 161, 105, 0.4) !important;
  }

  .sd-gate-error {
    min-height: 22px;
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    color: #FF8585;
    text-align: center;
    margin-top: 10px;
    opacity: 0;
    transform: translateY(-3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .sd-gate-error.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { SITE_AUTH_CONFIG } from '../config/sitePassword';

  const gate = document.getElementById('sd-password-gate');
  const form = document.getElementById('sd-gate-form') as HTMLFormElement | null;
  const input = document.getElementById('sd-passkey-input') as HTMLInputElement | null;
  const inputWrapper = document.getElementById('sd-input-wrapper');
  const errorBox = document.getElementById('sd-gate-error');
  const submitBtn = document.getElementById('sd-gate-submit');
  const toggleBtn = document.getElementById('sd-toggle-visibility');
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');

  const STORAGE_KEY = SITE_AUTH_CONFIG.storageKey || 'suria_site_authenticated';

  function isAuthenticated(): boolean {
    try {
      return sessionStorage.getItem(STORAGE_KEY) === 'true';
    } catch (e) {
      return false;
    }
  }

  function markAuthenticated() {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch (e) {
      // Storage unavailable fallback
    }
  }

  function unlockSite(animated = true) {
    document.documentElement.classList.remove('sd-locked');

    if (animated && gate) {
      gate.classList.add('is-unlocking');
      setTimeout(() => {
        gate.classList.add('is-hidden');
      }, 750);
    } else if (gate) {
      gate.classList.add('is-hidden');
    }

    // Dispatch event to announce site unlocked
    window.dispatchEvent(new CustomEvent('suria:unlocked'));
  }

  // Check state on script execution
  if (isAuthenticated()) {
    unlockSite(false);
  } else {
    setTimeout(() => {
      input?.focus();
    }, 150);
  }

  // Toggle passkey visibility
  toggleBtn?.addEventListener('click', () => {
    if (!input) return;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    if (eyeIcon && eyeOffIcon) {
      if (isPassword) {
        eyeIcon.classList.add('is-hidden');
        eyeOffIcon.classList.remove('is-hidden');
      } else {
        eyeIcon.classList.remove('is-hidden');
        eyeOffIcon.classList.add('is-hidden');
      }
    }
    input.focus();
  });

  // Clear error on typing
  input?.addEventListener('input', () => {
    if (inputWrapper?.classList.contains('is-invalid')) {
      inputWrapper.classList.remove('is-invalid');
    }
    if (errorBox) {
      errorBox.classList.remove('is-visible');
      errorBox.textContent = '';
    }
  });

  // Handle Form Submission
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;

    const enteredKey = input.value.trim().toLowerCase();
    const authorizedKeys = SITE_AUTH_CONFIG.passwords.map((p) => p.toLowerCase());

    const isMatch = authorizedKeys.includes(enteredKey);

    if (isMatch) {
      markAuthenticated();
      if (inputWrapper) inputWrapper.classList.remove('is-invalid');
      if (errorBox) {
        errorBox.classList.remove('is-visible');
        errorBox.textContent = '';
      }
      if (submitBtn) {
        submitBtn.classList.add('is-success');
      }

      setTimeout(() => {
        unlockSite(true);
      }, 350);
    } else {
      if (inputWrapper) {
        inputWrapper.classList.remove('is-invalid');
        void inputWrapper.offsetWidth;
        inputWrapper.classList.add('is-invalid');
      }
      if (errorBox) {
        errorBox.textContent = 'Incorrect password. Please try again.';
        errorBox.classList.add('is-visible');
      }
      input.select();
      input.focus();

      if ('vibrate' in navigator) {
        try {
          navigator.vibrate(200);
        } catch (e) {}
      }
    }
  });

  // Re-lock studio handler
  window.addEventListener('suria:lock', () => {
    try {
      sessionStorage.removeItem(STORAGE_KEY);
    } catch (e) {}
    window.location.reload();
  });
</script>
