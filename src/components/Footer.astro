---
// Footer component
---

<footer class="sd-footer sd-dark sd-section-track">
  <div class="sd-footer-content">
    <span class="sd-footer-brand sd-reveal-left" data-reveal-delay="100">Suria Design</span>
    <span class="sd-footer-policy sd-reveal" data-reveal-delay="150">By referral and appointment</span>
    <div class="sd-footer-meta sd-reveal-right" data-reveal-delay="200">
      <a href="mailto:hello@suria.design" class="sd-footer-email">[hello@suria.design]</a>
      <span class="sd-footer-copyright">© 2026 Suria Design</span>
      <button type="button" id="sd-lock-preview-btn" class="sd-footer-lock" title="Lock the studio with passkey">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Lock studio preview
      </button>
    </div>
  </div>
</footer>

<script>
  document.getElementById('sd-lock-preview-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('suria:lock'));
  });
</script>

<style>
  .sd-footer {
    width: 100%;
    background: #232B33;
    color: #AEB6BD;
    border-top: 1px solid #3A444E;
    box-sizing: border-box;
  }

  .sd-footer-content {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 56px 80px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 15px;
  }

  .sd-footer-brand {
    font-weight: 500;
    font-size: 26px;
    color: #E8EAE7;
  }

  .sd-footer-policy {
    align-self: center;
  }

  .sd-footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .sd-footer-email {
    text-decoration: none;
    color: #AEB6BD;
  }

  .sd-footer-email:hover {
    color: #E8EAE7;
  }

  .sd-footer-copyright {
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
  }

  .sd-footer-lock {
    background: transparent;
    border: none;
    color: #6C7681;
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    cursor: pointer;
    padding: 6px 0;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .sd-footer-lock:hover {
    color: #E8EAE7;
  }

  @media (max-width: 768px) {
    .sd-footer-content {
      flex-direction: column;
      gap: 32px;
      padding: 40px 24px;
      align-items: flex-start;
    }
    .sd-footer-policy {
      align-self: flex-start;
    }
    .sd-footer-meta {
      align-items: flex-start;
    }
  }
</style>
