
---
// Studio philosophy section
---

<section id="studio" class="sd-studio sd-section-track">
  <div class="sd-studio-content">
    <h2 class="sd-studio-heading sd-reveal-left" data-reveal-delay="100">The studio</h2>
    <p class="sd-studio-body sd-reveal-right" data-reveal-delay="200">
      Jewelry is our first medium. Each piece is conceived one to one, with proportion, stone and setting chosen for the person who will wear it.
    </p>
  </div>
</section>

<style>
  .sd-studio {
    width: 100%;
    height: auto;
    min-height: auto;
    flex-shrink: 0;
    background: #E8EAE7;
  }

  .sd-studio-content {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 120px 80px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 32px;
    align-items: start;
  }

  .sd-studio-heading {
    grid-column: span 3;
    margin: 0;
    padding-top: 14px;
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 14px;
    font-weight: 400;
    color: #56606A;
    text-transform: lowercase;
    letter-spacing: 0.05em;
  }

  .sd-studio-body {
    grid-column: 4 / span 8;
    margin: 0;
    font-weight: 300;
    font-size: 40px;
    line-height: 1.36;
    color: #1F262D;
  }

  @media (max-width: 1024px) {
    .sd-studio {
      height: auto;
      min-height: auto;
    }
    .sd-studio-content {
      padding: 80px 40px;
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
    .sd-studio-heading {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .sd-studio-body {
      grid-column: 1 / -1;
      font-size: 30px;
    }
  }

  @media (max-width: 640px) {
    .sd-studio-content {
      padding: 60px 24px;
    }
    .sd-studio-body {
      font-size: 24px;
      line-height: 1.4;
    }
  }
</style>
