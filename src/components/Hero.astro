---
import Header from './Header.astro';

interface Props {
  accent?: string;
}

const { accent = "#E0A030" } = Astro.props;
---

<div class="sd-hero sd-section-track">
  <!-- Dimming overlay -->
  <div class="sd-hero-overlay" aria-hidden="true"></div>

  <!-- Ambient glowing color circle with blend mode -->
  <div class="sd-hero-orb sd-reveal-right" aria-hidden="true" style={`background: ${accent};`} data-reveal-delay="200"></div>

  <!-- Top Nav -->
  <Header />

  <!-- Hero Content -->
  <section class="sd-hero-content">
    <div class="sd-hero-text sd-reveal-left" data-reveal-delay="100">
      <h1 class="sd-hero-title">Suria<br />Design</h1>
      <p class="sd-hero-description">
        Suria Design is a design studio beginning with fine jewelry. We work privately, by referral and appointment.
      </p>
      <div class="sd-hero-actions">
        <a href="#contact" class="sd-btn-primary">Request an appointment</a>
        <a href="#work" class="sd-btn-link">See selected work</a>
      </div>
    </div>
  </section>
</div>

<style>
  .sd-hero {
    position: relative;
    width: 100%;
    min-height: 956px;
    height: 956px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    color: #F2F3F0;
    background-color: #2A3036;
    background-image: url(/assets/806408f67066834bd64370cdf37369f2.jpg);
    background-size: cover;
    background-position: center 55%;
    overflow: hidden;
  }

  .sd-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(22, 27, 32, 0.42);
    z-index: 0;
  }

  .sd-hero-orb {
    position: absolute;
    top: 150px;
    right: max(150px, calc(50% - 720px + 150px));
    width: 400px;
    height: 400px;
    border-radius: 50%;
    mix-blend-mode: color;
    z-index: 1;
    pointer-events: none;
  }

  .sd-hero-content {
    position: relative;
    z-index: 2;
    flex-grow: 1;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 24px 80px 88px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 32px;
    align-items: end;
  }

  .sd-hero-text {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .sd-hero-title {
    margin: 0;
    font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 300;
    font-size: 176px;
    line-height: 0.95;
    letter-spacing: normal;
  }

  .sd-hero-description {
    margin: 0;
    max-width: 500px;
    font-size: 21px;
    line-height: 1.55;
    font-weight: 300;
  }

  .sd-hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .sd-btn-primary {
    text-decoration: none;
    background: #F2F3F0;
    color: #1F262D;
    font-size: 15px;
    font-weight: 500;
    padding: 17px 30px;
    border-radius: 999px;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .sd-btn-primary:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
    color: #1F262D;
  }

  .sd-btn-link {
    font-size: 15px;
    color: #F2F3F0;
    text-decoration: none;
    border-bottom: 1px solid #F2F3F0;
    padding: 12px 0 3px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .sd-btn-link:hover {
    color: #D5D9DC;
    border-color: #D5D9DC;
  }

  @media (max-width: 1024px) {
    .sd-hero {
      min-height: 700px;
      height: auto;
    }
    .sd-hero-content {
      padding: 40px 40px 60px;
    }
    .sd-hero-title {
      font-size: 110px;
    }
    .sd-hero-text {
      grid-column: span 12;
    }
  }

  @media (max-width: 640px) {
    .sd-hero-content {
      padding: 24px 24px 48px;
    }
    .sd-hero-title {
      font-size: 72px;
    }
    .sd-hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
