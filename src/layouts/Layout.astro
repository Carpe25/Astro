---
import 'lenis/dist/lenis.css';
import PasswordGate from '../components/PasswordGate.astro';

interface Props {
  title?: string;
  accent?: string;
}

const { 
  title = "Suria Design — Fine Jewelry Studio",
  accent = "#E0A030"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Synchronous passkey lock check to eliminate any flash of protected content -->
    <script is:inline>
      (function() {
        try {
          if (sessionStorage.getItem('suria_site_authenticated') !== 'true') {
            document.documentElement.classList.add('sd-locked');
          }
        } catch (e) {
          document.documentElement.classList.add('sd-locked');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global define:vars={{ accent }}>
      :root {
        --sd-accent: var(--accent, #E0A030);
        --sd-bg: #E8EAE7;
        --sd-text: #1F262D;
        --sd-muted: #56606A;
        --sd-subtle: #3F4850;
        --sd-border: #C9CDC9;
        --sd-dark-bg: #232B33;
        --sd-dark-text: #E8EAE7;
        --sd-dark-muted: #AEB6BD;
        --sd-dark-border: #3A444E;
        --sd-font-sans: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --sd-font-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--sd-bg);
        color: var(--sd-text);
        font-family: var(--sd-font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--sd-text);
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--sd-muted);
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--sd-text);
        outline-offset: 4px;
      }

      .sd-field:focus {
        outline: none;
        border-bottom-color: #E8EAE7 !important;
      }

      .sd-field option {
        color: #1F262D;
        background: #E8EAE7;
      }

      .sd-dark a {
        color: var(--sd-dark-text);
      }

      .sd-dark a:hover {
        color: var(--sd-dark-muted);
      }

      .sd-dark a:focus-visible,
      .sd-dark button:focus-visible {
        outline-color: var(--sd-dark-text);
      }

      /* Soft motion entrance when components are active in viewport */
      html.has-motion .sd-section-track {
        opacity: 0;
        transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity;
      }

      html.has-motion .sd-section-track.is-active-view {
        opacity: 1;
      }

      /* Content coming from the LEFT side */
      html.has-motion .sd-reveal-left {
        opacity: 0;
        transform: translateX(-52px);
        filter: blur(4px);
        transition: opacity 1.15s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.15s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.15s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-section-track.is-active-view .sd-reveal-left,
      html.has-motion .sd-reveal-left.is-revealed {
        opacity: 1;
        transform: translateX(0);
        filter: blur(0);
      }

      /* Content coming from the RIGHT side */
      html.has-motion .sd-reveal-right {
        opacity: 0;
        transform: translateX(52px);
        filter: blur(4px);
        transition: opacity 1.15s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.15s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.15s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-section-track.is-active-view .sd-reveal-right,
      html.has-motion .sd-reveal-right.is-revealed {
        opacity: 1;
        transform: translateX(0);
        filter: blur(0);
      }

      /* Inner component elements soft cascade */
      html.has-motion .sd-reveal {
        opacity: 0;
        transform: translateY(22px);
        filter: blur(3px);
        transition: opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.05s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.05s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-section-track.is-active-view .sd-reveal,
      html.has-motion .sd-reveal.is-revealed {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      html.has-motion .sd-reveal-fade {
        opacity: 0;
        filter: blur(6px);
        transform: translateY(12px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, filter, transform;
      }

      html.has-motion .sd-section-track.is-active-view .sd-reveal-fade,
      html.has-motion .sd-reveal-fade.is-revealed {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
      }

      /* Slower, graceful reveal (used for How it works steps) */
      html.has-motion .sd-reveal-slow {
        opacity: 0;
        transform: translateX(36px);
        filter: blur(4px);
        transition: opacity 1.45s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.45s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.45s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-section-track.is-active-view .sd-reveal-slow,
      html.has-motion .sd-reveal-slow.is-revealed {
        opacity: 1;
        transform: translateX(0);
        filter: blur(0);
      }

      /* Hero word-by-word reveal */
      .sd-word-reveal {
        display: inline-block;
        opacity: 0;
        transform: translateY(20px);
        filter: blur(4px);
        transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.1s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--word-delay, 0ms);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-hero.is-active-view .sd-word-reveal {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      .sd-hero-actions-reveal {
        opacity: 0;
        transform: translateY(16px);
        filter: blur(3px);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--actions-delay, 2200ms);
        will-change: opacity, transform, filter;
      }

      html.has-motion .sd-hero.is-active-view .sd-hero-actions-reveal {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      @media (prefers-reduced-motion: reduce) {
        html.has-motion .sd-section-track,
        html.has-motion .sd-reveal-left,
        html.has-motion .sd-reveal-right,
        html.has-motion .sd-reveal,
        html.has-motion .sd-reveal-fade,
        html.has-motion .sd-reveal-slow,
        .sd-word-reveal,
        .sd-hero-actions-reveal {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
          transition: none !important;
        }
      }

      /* Locked overlay and protected content visibility */
      html.sd-locked,
      html.sd-locked body {
        overflow: hidden !important;
        height: 100vh !important;
      }

      html.sd-locked #sd-page-content {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        user-select: none !important;
      }

      html:not(.sd-locked) #sd-password-gate {
        display: none !important;
      }

      #sd-page-content {
        opacity: 1;
        visibility: visible;
        transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>
  <body>
    <PasswordGate accent={accent} />
    <div id="sd-page-content" class="sd-protected-content">
      <slot />
    </div>

    <script>
      import Lenis from 'lenis';

      // Enable progressive motion class
      document.documentElement.classList.add('has-motion');

      const lenis = new Lenis({
        autoRaf: true,
        anchors: false, // Handle anchor clicks explicitly for custom slow/smooth animation
        duration: 1.6, // Enhanced smooth gliding for general page wheel scroll
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 1.5,
      });

      // Pause Lenis if site is locked
      if (document.documentElement.classList.contains('sd-locked')) {
        lenis.stop();
      }

      window.addEventListener('suria:unlocked', () => {
        lenis.start();

        // Trigger hero reveal immediately upon unlocking
        const hero = document.querySelector('.sd-hero');
        if (hero) {
          hero.classList.add('is-active-view');
          const children = hero.querySelectorAll(
            '.sd-reveal, .sd-reveal-left, .sd-reveal-right, .sd-reveal-fade, .sd-reveal-slow'
          );
          children.forEach((child) => {
            const delay = child.getAttribute('data-reveal-delay');
            if (delay) {
              (child as HTMLElement).style.transitionDelay = `${delay}ms`;
            }
            child.classList.add('is-revealed');
          });
        }
      });

      // Smooth and slower cinematic scrolling when clicking navigation buttons/links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.length > 1) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target, {
                offset: 0,
                duration: 2.4, // Slower, graceful scroll when redirected to a component
                easing: (t) =>
                  t < 0.5
                    ? 4 * t * t * t
                    : 1 - Math.pow(-2 * t + 2, 3) / 2, // Elegant easeInOutCubic curve
              });
              history.pushState(null, '', href);
            }
          }
        });
      });

      // Soft component reveal on first scroll / arrival in viewport
      const trackedSections = document.querySelectorAll('.sd-section-track');
      const standaloneSelector = '.sd-reveal:not(.sd-section-track *), .sd-reveal-left:not(.sd-section-track *), .sd-reveal-right:not(.sd-section-track *), .sd-reveal-fade:not(.sd-section-track *)';
      const standaloneReveals = document.querySelectorAll(standaloneSelector);

      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.add('is-active-view');

                // Trigger staggered delays for child items inside the component
                const children = target.querySelectorAll('.sd-reveal, .sd-reveal-left, .sd-reveal-right, .sd-reveal-fade, .sd-reveal-slow');
                children.forEach((child) => {
                  const delay = child.getAttribute('data-reveal-delay');
                  if (delay) {
                    (child as HTMLElement).style.transitionDelay = `${delay}ms`;
                  }
                  child.classList.add('is-revealed');
                });

                obs.unobserve(target); // Animate once on first active view
              }
            });
          },
          {
            root: null,
            rootMargin: '0px 0px -12% 0px',
            threshold: 0.05,
          }
        );

        trackedSections.forEach((section) => sectionObserver.observe(section));

        // Standalone reveals not inside a tracked section
        standaloneReveals.forEach((el) => {
          const standaloneObs = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const delay = (entry.target as HTMLElement).getAttribute('data-reveal-delay');
                  if (delay) {
                    (entry.target as HTMLElement).style.transitionDelay = `${delay}ms`;
                  }
                  entry.target.classList.add('is-revealed');
                  obs.unobserve(entry.target);
                }
              });
            },
            {
              root: null,
              rootMargin: '0px 0px -12% 0px',
              threshold: 0.05,
            }
          );
          standaloneObs.observe(el);
        });
      } else {
        trackedSections.forEach((el) => el.classList.add('is-active-view'));
        standaloneReveals.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
