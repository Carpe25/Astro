# Admin carousel password: pick your own, never commit the real one
ADMIN_PASSWORD=change-me
# Optional: separate key for signing session cookies
SESSION_SECRET=

# Saving from /admin-carousel commits through the GitHub API.
# Token: fine-grained PAT, this repo only, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=jaytcdj-dev/Astro
GITHUB_BRANCH=main
